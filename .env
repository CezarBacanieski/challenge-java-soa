# Backend
DB_URL=jdbc:postgresql://localhost:5432/fordvinshare
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (base64 of >=32 random bytes)
APP_JWT_SECRET_BASE64=CHANGE_ME_BASE64_32B_OR_MORE

# AES-256-GCM data-at-rest key (base64 of 32 random bytes)
APP_CRYPTO_KEY_BASE64=CHANGE_ME_BASE64_32B

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookies (set true when behind HTTPS)
APP_COOKIES_SECURE=false
APP_COOKIES_SAMESITE=Strict

# Optional: bootstrap users
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPassword!123
APP_BOOTSTRAP_ANALYST_EMAIL=analyst@example.com
APP_BOOTSTRAP_ANALYST_PASSWORD=ChangeThisAnalystPassword!123

